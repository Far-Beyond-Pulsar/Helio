+// The staggered lattice has vertical columns with alternating 1/3-pixel
+// spacing. Within a column pair, interpolate the row positions before finding
+// the vertical fraction. This brackets actual samples without changing their
+// decorrelation or loading a wider geometry neighbourhood.
+fn reconstruction_position(pixel: vec2<f32>) -> vec2<f32> {
+    if !USE_TILE_PRESAMPLING || globals.sample_scale==1u {
+        return pixel/f32(globals.sample_scale)-0.5;
+    }
+    let last=vec2<i32>(globals.sample_size)-1;
+    let max_base=max(last-1,vec2<i32>(0));
+    var base=clamp(vec2<i32>(floor(pixel/f32(globals.sample_scale))),vec2<i32>(0),last);
+    let first_x=f32(sample_pixel(vec2<u32>(u32(base.x),0u),globals.frame).x)+0.5;
+    if pixel.x<first_x { base.x-=1; }
+    base.x=clamp(base.x,0,max_base.x);
+    let x0=f32(sample_pixel(vec2<u32>(u32(base.x),0u),globals.frame).x)+0.5;
+    let x1=f32(sample_pixel(vec2<u32>(u32(base.x+1),0u),globals.frame).x)+0.5;
+    let fx=select(0.0,clamp((pixel.x-x0)/max(x1-x0,1.0),0.0,1.0),last.x>0);
+    let row0=mix(f32(sample_pixel(vec2<u32>(base),globals.frame).y),
+        f32(sample_pixel(vec2<u32>(base+vec2<i32>(1,0)),globals.frame).y),fx)+0.5;
+    if pixel.y<row0 { base.y-=1; }
+    base.y=clamp(base.y,0,max_base.y);
+    let y0=mix(f32(sample_pixel(vec2<u32>(base),globals.frame).y),
+        f32(sample_pixel(vec2<u32>(base+vec2<i32>(1,0)),globals.frame).y),fx)+0.5;
+    let y1=mix(f32(sample_pixel(vec2<u32>(base+vec2<i32>(0,1)),globals.frame).y),
+        f32(sample_pixel(vec2<u32>(base+vec2<i32>(1,1)),globals.frame).y),fx)+0.5;
+    let fy=select(0.0,clamp((pixel.y-y0)/max(y1-y0,1.0),0.0,1.0),last.y>0);
+    return vec2<f32>(base)+vec2<f32>(fx,fy);
+}
