+#[test]
+fn larger_coarse_batches_respect_edit_reference_storage() {
+    let mut world = World::default();
+    for _ in 0..512 {
+        world
+            .apply_edit(Edit {
+                cell: [0; 3],
+                radius: 0.05,
+                material: 0,
+            })
+            .unwrap();
+    }
+    let mut residency = Residency::new(BRICK_CAPACITY);
+    residency.stats.ready = true;
+    residency.pending = Some(Pending {
+        plan: Plan {
+            nodes: vec![],
+            leaves: vec![],
+            world: Arc::new(world),
+            view: view(DVec3::ZERO),
+            pixels: 1.0,
+        },
+        jobs: (0..1024)
+            .map(|slot| Job {
+                low: [0; 3],
+                level: 4,
+                slot,
+                pad: [0; 3],
+            })
+            .collect(),
+        cursor: 0,
+    });
+    for remaining in [512, 0] {
+        let (batch, references, _) = residency.next_batch().unwrap();
+        assert_eq!(batch.len(), 512);
+        assert_eq!(references.len(), 262_144);
+        for job in batch {
+            let start = job.pad[0] as usize;
+            let end = start + job.pad[1] as usize;
+            assert_eq!(&references[start..end], &(0..512).collect::<Vec<u32>>());
+        }
+        assert_eq!(residency.stats.pending, remaining);
     }
 }
 
